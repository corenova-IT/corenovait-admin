# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# env files: NEVER commit real keys or passwords. Only .env.example is tracked.
.env
.env.*
!.env.example

# logs and OS noise
npm-debug.log*
.DS_Store
Thumbs.db

# uploaded files in development (production uses UPLOAD_DIR outside the app)
/.uploads/

# generated first-admin SQL files (contain a password hash; delete after import)
/.private/

# local database data, logs and backups (db:local keeps its data outside the repo by default;
# these cover DEV_DB_DIR pointed inside it, and manual dumps)
/.mysql-data/
/mysql-data/
*.log
/backups/
*.sql.gz
*.dump
