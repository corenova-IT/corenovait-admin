# Copy to .env.local for local development and fill in. .env.local is git-ignored; never commit it.
# In production, set these in Hostinger's panel for the Node.js app instead of a file.
# Every value here is server-only: there are no NEXT_PUBLIC_ variables.

# MySQL 8. Local: your own MySQL (Docker or a normal install).
# Production: the Hostinger database, reached as localhost from the app. Never open it to the internet.
DATABASE_URL=mysql://corenovait:change-me@127.0.0.1:3306/corenovait_admin
# Optional: connections in the pool (shared hosting allows only a few)
DATABASE_POOL_SIZE=5

# 32 random bytes, base64. Encrypts two-factor secrets at rest. Generate with: npm run gen:key
# Keep a copy in your password manager: if it's lost, everyone must set up two-factor again.
APP_ENCRYPTION_KEY=

# The URL this portal is served from (used in invite and password-reset links)
SITE_URL=http://localhost:3000

# Sign out after this many minutes without activity, and after this many hours regardless
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Email through Resend (invites and password resets). In development, leave these empty
# and the links are printed in the dev-server terminal instead.
RESEND_API_KEY=
MAIL_FROM=CoreNovaIT Portal <portal@corenovait.com.au>

# Scheduler for reminders and notification emails (see README, "Notifications and the cron job").
# At least 32 random characters, e.g. from: npm run gen:key
CRON_SECRET=

# Uploaded files (receipts, attachments). Must be an absolute path OUTSIDE the app folder
# and public_html, so deploys don't wipe it and it can never be served directly.
# Optional in development (defaults to ./.uploads, which is git-ignored).
UPLOAD_DIR=
UPLOAD_MAX_MB=10

# One-time first-admin seed (npm run seed:admin). Set, run once, then DELETE these lines.
# Never paste them into chat or commit them.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Tests only: an existing MySQL server to create throwaway test databases on.
# Leave empty and `npm test` downloads and runs a temporary MySQL 8.4 by itself.
TEST_DATABASE_URL=
