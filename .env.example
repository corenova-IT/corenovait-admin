# Copy to .env.local and fill in. .env.local is git-ignored; never commit it.
# Use the NEW Supabase project made for the admin portal, not the public site's.

# Public (safe in the browser): Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses row-level security,
# so it is used only for inviting users, banning/unbanning, and the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# The URL this portal is served from (used in invite and password-reset links)
SITE_URL=http://localhost:3000

# Log out after this many minutes without activity
SESSION_IDLE_MINUTES=30

# One-time first-admin seed (npm run seed:admin). Set these in .env.local, run
# the script once, then DELETE both lines. Never paste them into chat or commit them.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
